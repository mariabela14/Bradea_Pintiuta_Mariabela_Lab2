@page
@model Bradea_Pintiuta_Mariabela_Lab2.Pages.BorrowingPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Member</th>
            <th>Book</th>
            <th>Author</th>
            <th>
                @Html.DisplayNameFor(model => model.Borrowing[0].ReturnDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Borrowing)
        {
            <tr>
                <td>@item.Member?.FullName</td>
                <td>@item.Book?.Title</td>
                <td>@item.Book?.Author?.FullName</td>
                <td>@Html.DisplayFor(modelItem => item.ReturnDate)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>