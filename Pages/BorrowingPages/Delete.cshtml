@page
@model Bradea_Pintiuta_Mariabela_Lab2.Pages.BorrowingPages.DeleteModel

@{
    ViewData["Title"] = "Delete Borrowing";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this borrowing?</h3>

<div>
    <h4>Borrowing</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Member</dt>
        <dd class="col-sm-10">
            @(Model.Borrowing.Member?.FullName ?? "Membru indisponibil")
        </dd>

        <dt class="col-sm-2">Book</dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Book?.Title
        </dd>

        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">
            @if (Model.Borrowing.Book?.Author is not null)
            {
                @($"{Model.Borrowing.Book.Author.LastName} {Model.Borrowing.Book.Author.FirstName}")
            }
            else
            {
                @:Autor indisponibil
            }
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Borrowing.ReturnDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Borrowing.ReturnDate)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Borrowing.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>