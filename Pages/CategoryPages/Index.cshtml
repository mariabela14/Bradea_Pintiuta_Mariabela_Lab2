@page "{id:int?}"
@model Bradea_Pintiuta_Mariabela_Lab2.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].CategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].BookCategories)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.CategoryData.Categories)
        {
            string selectedRow = "";

            if (item.ID == Model.CategoryID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.CategoryName)
                </td>

                <td>
                    <a asp-page="./Index"
                       asp-route-id="@item.ID">Select</a> |

                    <a asp-page="./Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-page="./Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-page="./Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryID != 0)
{
    <h3>Books in Selected Category</h3>

    <table class="table">
        @foreach (var item in Model.CategoryData.Categories)
        {
            if (item.ID == Model.CategoryID)
            {
                string selectedRow = "table-success";

                <tr class="@selectedRow">
                    <td>
                        @{
                            foreach (var b in Model.CategoryData.Books)
                            {
                                @b.Title
                                @: @b.Author?.FirstName @b.Author?.LastName
                                <br />
                            }
                        }
                    </td>
                </tr>
            }
        }
    </table>
}