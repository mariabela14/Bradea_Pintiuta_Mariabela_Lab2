@page
@model Bradea_Pintiuta_Mariabela_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form>
    <p>
        <label>Choose an Author:</label>
        <select asp-for="AuthorID" asp-items="Model.Authors">
            <option value="">All Authors</option>
        </select>
        <input type="submit" value="Filter" class="btn btn-primary" />
    </p>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Title)
            </th>
            <th>
                Author
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].PublishingDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Publisher.PublisherName)
            </th>
            <th>
                Categories
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>

                <td>
                    @item.Author?.FirstName @item.Author?.LastName
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>

                <td>
                    @if (item.Publisher != null)
                    {
                        @item.Publisher.PublisherName
                    }
                </td>

                <td>
                    @if (item.BookCategories != null)
                    {
                        foreach (var category in item.BookCategories)
                        {
                            @category.Category.ID @: @category.Category.CategoryName
                            <br />
                        }
                    }
                </td>

                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>